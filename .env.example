# Copy this file to .env and fill in real values locally.
# Never commit .env or other local env files.

# PostgreSQL connection string (Neon, Supabase, or local Postgres)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# --- Future secrets (placeholders only; used in later stages) ---

# Auth (Auth.js / NextAuth) — Stage 9+
# AUTH_SECRET="replace-with-a-long-random-string"
# AUTH_URL="http://localhost:3000"

# Paynow Zimbabwe (test mode) — Stage 5
# PAYNOW_INTEGRATION_ID="your-paynow-integration-id"
# PAYNOW_INTEGRATION_KEY="your-paynow-integration-key"
# PAYNOW_RESULT_URL="https://your-domain.example/api/payments/paynow/result"
# PAYNOW_RETURN_URL="https://your-domain.example/checkout/return"

# Notifications (SMS / WhatsApp / email) — Stage 7
# SMS_PROVIDER_API_KEY="your-sms-api-key"
# WHATSAPP_PROVIDER_API_KEY="your-whatsapp-api-key"
# EMAIL_PROVIDER_API_KEY="your-email-api-key"
# EMAIL_FROM="tickets@example.com"
